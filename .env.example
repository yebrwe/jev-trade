# --- TypeSafe (Jev) ---
TYPESAFE_API_KEY=your_typesafe_key
TYPESAFE_MODEL=jev-latest

# --- Binance USDT-M Futures ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false          # true -> 주문을 Demo Trading(테스트넷) https://demo-fapi.binance.com 으로 보냄 (데모 API 키 필요)
BINANCE_TESTNET_HOST=demo-fapi.binance.com
MARKET_DATA_TESTNET=false      # 시세·캔들은 기본적으로 메인넷 공개 데이터 사용 (키 불필요, 실제 가격)

# --- Market ---
SYMBOL=BTC/USDT:USDT
TIMEFRAMES=1m,5m,10m,15m,30m,1h,5h,1d,1w,1y
DECISION_TIMEFRAME=5m          # 이 캔들이 마감될 때마다 판단
LOOP_INTERVAL_SEC=0            # >0 이면 캔들 마감 대신 고정 간격(초)으로 판단

# --- Execution / Risk (모두 코드가 소유하는 규칙) ---
DRY_RUN=true                   # true: 페이퍼 트레이딩(주문 안 냄)
LEVERAGE=3
MARGIN_MODE=isolated
RISK_PER_TRADE_PCT=1.0         # 1회 손절 시 잃을 자본 비율(%)
MAX_POSITION_PCT=30            # 자본 대비 최대 명목 포지션(%)
ATR_STOP_MULT=2.0              # 손절 = ATR * 배수 (DECISION_TIMEFRAME 기준)
ATR_TP_MULT=3.0                # 익절 = ATR * 배수
COOLDOWN_CANDLES=3             # 청산 후 재진입 금지 캔들 수
MAX_TRADES_PER_DAY=10

# --- Jev 판단 게이트 (confidence / probability 임계값) ---
MIN_ENTRY_CONFIDENCE=0.50
MIN_ENTRY_PROB=0.60
MIN_SETUP_SCORE=2.0            # setup_quality 기대 레벨 (0=no edge .. 3=strong)
CHOPPY_MAX=0.50
MIN_EXIT_PROB=0.55
THESIS_INVALIDATED_THRESHOLD=0.70

LOG_DIR=logs

# --- Perspective layer: Claude writes the macro / intraday view, Jev reads it ---
PERSPECTIVE_BACKEND=cli            # cli = Claude Code CLI(`claude -p`, 로그인 세션 사용, API 키 불필요) / api = Anthropic SDK
PERSPECTIVE_CLI_MODEL=opus         # cli 백엔드 모델 별칭 (opus / sonnet / fable)
PERSPECTIVE_CLI_BUDGET_USD=1.5     # 관점 1회 생성 비용 상한 (실측 약 $0.8, 웹검색 6회 포함)
PERSPECTIVE_CLI_TIMEOUT_SEC=300
ANTHROPIC_API_KEY=                 # api 백엔드일 때만 필요. cli 백엔드에서는 자동으로 무시됨
PERSPECTIVE_MODEL=claude-opus-5    # api 백엔드 모델
PERSPECTIVE_TTL_HOURS=24           # 이 시간 지나거나 UTC 날짜가 바뀌면 재생성
PERSPECTIVE_WEB_SEARCH=true        # Claude 웹검색 툴로 당일 증시/정부 발표 보강
ANTHROPIC_FALLBACKS=true           # 안전 거절 시 서버측 폴백 모델 사용

# --- News monitor: Jev screens Google News headlines periodically ---
NEWS_CHECK_MINUTES=10             # 정기 점검 주기 (Jev만 사용하므로 저렴)
# NEWS_FEEDS=coindesk,cointelegraph,cnbc_top,fed_press,sec_press   ( 쉼표 구분; 이름 또는 RSS URL, 비우면 검증된 12개 공식 피드 )
PRICE_SHOCK_PCT=1.5               # 1분봉 기준 이 % 이상 급변동 시 즉시 뉴스 점검
PRICE_SHOCK_WINDOW_MIN=5
NEWS_MATERIAL_THRESHOLD=0.60       # Noul P(material) 이상이면 "관점에 없는 중대 뉴스"
NEWS_MATERIAL_MIN_COUNT=2          # 이 개수 이상이면 Claude가 관점 갱신
NEWS_SHOCK_THRESHOLD=0.70          # Noul P(shock) 이상이면 즉시 갱신 + 신규진입 차단
SHOCK_BLOCK_MINUTES=60             # 갱신 실패 시 신규진입 차단 유지 시간
BLOCK_ENTRY_ON_HIGH_EVENT_RISK=true
RESPECT_TRADING_STANCE=true        # perspective.trading_stance 와 반대 방향 진입 차단
MACRO_CONFLICT_MAX=0.60            # Jev: perspective가 해당 방향에 반대할 확률 상한

# --- Live account safety ---
ALLOW_HEDGE_MODE=false            # 헤지 모드 계정이면 기본은 실행 거부. true면 positionSide 주문 사용(실계좌 미검증)

# --- Replay realism ---
REPLAY_SLIPPAGE_BPS=3             # 시장가 체결 슬리피지 (bp)
REPLAY_FEE_BPS=5                  # 테이커 수수료 (bp, 양쪽 레그)
